# ---- Dayflow backend environment ----
# Copy this file to backend/.env and fill in real values.
# .env is git-ignored — never commit real secrets.

# Secret used for Flask session signing
SECRET_KEY=change-me-to-a-long-random-string

# Secret used to sign JWT access tokens (falls back to SECRET_KEY if empty)
JWT_SECRET_KEY=change-me-to-another-long-random-string

# Access token lifetime in hours
JWT_EXPIRES_HOURS=24

# Database (SQLite for local hackathon development)
DATABASE_URL=sqlite:///dayflow.db

# Comma-separated list of allowed frontend origins (* = allow all; fine for
# token-based auth in local dev — restrict in production)
CORS_ORIGINS=*

# Dev conveniences: create tables & seed demo data automatically on startup
AUTO_INIT_DB=true
AUTO_SEED=true
